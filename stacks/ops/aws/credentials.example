# IAM Roles Anywhere via credential_process (no static keys).
# Paths below are on the keeper host; aws_signing_helper must be executable.
#
# Requires AWS CLI v2 on the host (credential_process runs locally).
# Do not use amazon/aws-cli Docker for uploads — its glibc is too old for
# aws_signing_helper.

[default]
credential_process = /opt/hcloud-security-cluster/stacks/ops/aws/aws_signing_helper credential-process --certificate /opt/hcloud-security-cluster/stacks/ops/aws/keeper.crt --private-key /opt/hcloud-security-cluster/stacks/ops/aws/keeper.key --trust-anchor-arn arn:aws:rolesanywhere:us-east-1:ACCOUNT:trust-anchor/TA_ID --profile-arn arn:aws:rolesanywhere:us-east-1:ACCOUNT:profile/PROFILE_ID --role-arn arn:aws:iam::ACCOUNT:role/keeper-backup-ra --region us-east-1
