# Copy to backup.env on the keeper host (same directory as backup.sh).
# chmod 600 backup.env — never commit backup.env, keeper.key, or credentials.

RETAIN_DAYS=14

# S3 off-site copy (leave BACKUP_S3_BUCKET empty to skip upload)
BACKUP_S3_BUCKET=gmh-keeper-backups-prod
BACKUP_S3_PREFIX=keeper/
AWS_REGION=us-east-1

# IAM Roles Anywhere (see stacks/ops/aws/credentials.example)
BACKUP_AWS_CREDS_DIR=/opt/hcloud-security-cluster/stacks/ops/aws
BACKUP_AWS_CREDS_FILE=/opt/hcloud-security-cluster/stacks/ops/aws/credentials

BACKUP_S3_STORAGE_CLASS=STANDARD_IA
BACKUP_S3_FULL_BUNDLE=1
BACKUP_S3_REMOVE_LOCAL_ARCHIVE=1
