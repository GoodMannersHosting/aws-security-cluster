# Hostname for Traefik (HTTPS). Webhook URL: https://<host>/v1/webhook
DOCO_CD_HOSTNAME=doco-cd.goodmanners.services

# HMAC secret (GitHub/GitLab/Gitea webhook "Secret"); generate with: openssl rand -base64 40
WEBHOOK_SECRET=

# Private repo clone token (GitHub fine-grained or classic PAT). Optional for public repos.
GIT_ACCESS_TOKEN=

# Serialize deploys so stacks apply in .doco-cd.yml order (avoids openbao before postgres).
MAX_CONCURRENT_DEPLOYMENTS=1

# Optional
TZ=UTC
LOG_LEVEL=INFO

# Deprecated: secrets are in stacks/doco-cd/secrets.enc.env (git). Host path kept
# for manual cold-start only before GitOps adoption.
# DOCO_CD_ENV_FILE=/opt/stacks/doco-cd/.env

# SOPS + age: secrets in git as secrets.enc.env; key on host only.
#   cp ../../.sops.yaml.example ../../.sops.yaml   # set age: to your public key
#   stacks/ops/setup-sops.sh                       # creates sops_age_key.txt on host
#   stacks/ops/encrypt-stack-secrets.sh            # refresh secrets.enc.env in clone
# Deploy with compose.sops.yaml so Doco-CD can decrypt at runtime.
