OPENBAO_HOSTNAME=keeper.goodmanners.services
PG_USER=openbao
PG_DB=openbao
PG_PASS=generate-strong-password

OPENBAO_CONFIG_DIR=/opt/stacks/openbao/config
OPENBAO_AWS_CREDS_DIR=/opt/stacks/openbao/aws
OPENBAO_DATA_DIR=/mnt/data/openbao
OPENBAO_POSTGRES_DATA=/mnt/data/postgres/openbao

# AWS KMS auto-unseal (Roles Anywhere or static creds in OPENBAO_AWS_CREDS_DIR)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RA_DURATION_SECONDS=3600
