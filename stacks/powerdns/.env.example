POWERDNS_API_HOSTNAME=pdns.goodmanners.services
POWERADMIN_HOSTNAME=poweradmin.goodmanners.services

POSTGRES_DB=pdns
POSTGRES_USER=pdns
POSTGRES_PASS=generate-strong-database-password

PDNS_AUTH_API_KEY=generate-128-char-api-key
PDNS_AUTH_WEB_KEY=generate-128-char-web-password

POWERDNS_POSTGRES_DATA=/mnt/data/postgres/powerdns
POWERADMIN_DATA_ROOT=/mnt/data/poweradmin

POWERADMIN_DNS_NS1=ns1.goodmanners.services
POWERADMIN_DNS_NS2=ns2.goodmanners.services
POWERADMIN_DNS_HOSTMASTER=hostmaster.goodmanners.services

# Set to 1 for first boot only to auto-create the admin account.
POWERADMIN_CREATE_ADMIN=0
POWERADMIN_ADMIN_USERNAME=admin
POWERADMIN_ADMIN_PASSWORD=generate-strong-admin-password
POWERADMIN_ADMIN_EMAIL=admin@goodmanners.services
POWERADMIN_ADMIN_FULLNAME=DNS Administrator
