# Required for Doco-CD deploys (Compose runs from git clone; bind mounts stay on host).
# Leave unset for manual `docker compose` from /opt/stacks/traefik (uses ./ paths).
ACME_EMAIL=you@example.com
TRAEFIK_DASHBOARD_HOSTNAME=traefik.goodmanners.services
TRAEFIK_CONFIG_PATH=/opt/stacks/traefik/traefik.yml
TRAEFIK_DYNAMIC_PATH=/opt/stacks/traefik/dynamic
TRAEFIK_ACME_DIR=/opt/stacks/traefik/acme
TRAEFIK_LOG_DIR=/var/log/traefik
