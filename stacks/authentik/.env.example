# Required
AUTHENTIK_HOSTNAME=auth.goodmanners.services
AUTHENTIK_SECRET_KEY=generate-with-openssl-rand-hex-32
PG_PASS=strong-random-database-password

# Optional (defaults shown)
PG_USER=authentik
PG_DB=authentik
POSTGRES_TAG=18-alpine
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.2

# Production data root on keeper.goodmanners.services
AUTHENTIK_DATA_ROOT=/mnt/sec-hil-1-authentik

# Forward-auth outpost route for Doco-CD (030-doco-cd-forward-auth.yaml)
DOCO_CD_HOSTNAME=doco-cd.goodmanners.services

# Git-managed blueprints (manual compose from /opt/stacks/authentik)
AUTHENTIK_BLUEPRINTS_PATH=/opt/hcloud-security-cluster/authentik/blueprints
