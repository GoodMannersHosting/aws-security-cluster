# Copy to config.env and fill in values from Authentik (Applications -> Keeper -> Provider).
export BAO_ADDR="${BAO_ADDR:-https://keeper.goodmanners.services}"
export AUTHENTIK_OIDC_DISCOVERY_URL="${AUTHENTIK_OIDC_DISCOVERY_URL:-https://auth.goodmanners.services/application/o/keeper/}"
export AUTHENTIK_CLIENT_ID=
export AUTHENTIK_CLIENT_SECRET=

# GitHub Actions (repo secret AUTHENTIK_CLIENT_ID): used by bao/sync-from-git.sh
# to substitute bound_audiences in OIDC role JSON. JWT bootstrap: github-jwt.env.example
