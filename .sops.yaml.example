# Copy to .sops.yaml in the repo root. Set age: from:
#   age-keygen -y /opt/stacks/doco-cd/sops_age_key.txt
# Commit .sops.yaml and stacks/*/secrets.enc.env (never the age secret key).
#
# https://github.com/getsops/sops
# https://github.com/kimdre/doco-cd/wiki/Encryption

creation_rules:
  - path_regex: (?i)^stacks/.+/secrets\.enc\.env$
    age: AGE_PUBLIC_KEY
