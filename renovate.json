{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Compose images: image: name:${TAG:-version}",
      "fileMatch": [
        "(^|/)stacks/.+/compose\\.ya?ml$",
        "(^|/)stacks/.+/docker-compose\\.ya?ml$"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[^\\s$\"']+):\\$\\{(?<envName>[A-Z0-9_]+):-(?<currentValue>[^}\"']+)\\}"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Compose images: image: ${IMAGE:-name}:${TAG:-version}",
      "fileMatch": ["(^|/)stacks/.+/compose\\.ya?ml$"],
      "matchStrings": [
        "image:\\s+\\$\\{(?<imageVar>[A-Z0-9_]+):-(?<depName>[^}]+)\\}:\\$\\{(?<envName>[A-Z0-9_]+):-(?<currentValue>[^}]+)\\}"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge minor, patch, pin, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates require manual review before deploy",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pin Docker images to SHA digests for immutable deploys",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Ignore floating latest tags on socket-proxy and similar",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "latest",
      "enabled": false
    },
    {
      "description": "Authentik publishes calendar versions",
      "matchPackageNames": ["ghcr.io/goauthentik/server"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>.*)?$"
    },
    {
      "description": "Group Pulumi npm dependencies per stack",
      "matchManagers": ["npm"],
      "matchFileNames": ["infrastructure/core-aws/**"],
      "groupName": "pulumi core-aws",
      "groupSlug": "pulumi-core-aws"
    },
    {
      "description": "Group Pulumi npm dependencies per stack",
      "matchManagers": ["npm"],
      "matchFileNames": ["infrastructure/authentik-aws/**"],
      "groupName": "pulumi authentik-aws",
      "groupSlug": "pulumi-authentik-aws"
    },
    {
      "description": "Group Pulumi npm dependencies per stack",
      "matchManagers": ["npm"],
      "matchFileNames": ["infrastructure/openbao-aws/**"],
      "groupName": "pulumi openbao-aws",
      "groupSlug": "pulumi-openbao-aws"
    },
    {
      "description": "Group Pulumi npm dependencies per stack",
      "matchManagers": ["npm"],
      "matchFileNames": ["infrastructure/emergency-bastion/**"],
      "groupName": "pulumi emergency-bastion",
      "groupSlug": "pulumi-emergency-bastion"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose", "custom.regex"],
      "matchFileNames": ["stacks/traefik/**"],
      "groupName": "traefik stack",
      "groupSlug": "stack-traefik"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose", "custom.regex"],
      "matchFileNames": ["stacks/authentik/**"],
      "groupName": "authentik stack",
      "groupSlug": "stack-authentik"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose", "custom.regex"],
      "matchFileNames": ["stacks/openbao/**"],
      "groupName": "openbao stack",
      "groupSlug": "stack-openbao"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose", "custom.regex"],
      "matchFileNames": ["stacks/doco-cd/**"],
      "groupName": "doco-cd stack",
      "groupSlug": "stack-doco-cd"
    },
    {
      "description": "Group container updates per Compose stack",
      "matchManagers": ["docker-compose", "custom.regex"],
      "matchFileNames": ["stacks/postgres/**"],
      "groupName": "postgres stack",
      "groupSlug": "stack-postgres"
    }
  ]
}
